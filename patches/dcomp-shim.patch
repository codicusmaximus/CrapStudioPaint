+
+FakeDevice::FakeDevice()
+{
+    EnterCriticalSection(&g_devLock); g_devices.push_back(this); LeaveCriticalSection(&g_devLock);
+}
+
+static void unregister_device(FakeDevice *d)
+{
+    EnterCriticalSection(&g_devLock);
+    for (auto it = g_devices.begin(); it != g_devices.end(); ++it)
+        if (*it == d) { g_devices.erase(it); break; }
+    LeaveCriticalSection(&g_devLock);
+}
+
+static void commit_all_devices()
+{
+    EnterCriticalSection(&g_devLock);
+    std::vector<FakeDevice *> devs = g_devices;
+    for (auto *d : devs) d->AddRef();
+    LeaveCriticalSection(&g_devLock);
+    for (auto *d : devs) { d->Commit(); d->Release(); }
+}
