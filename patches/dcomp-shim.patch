+/* [crapstudiopaint] DCompositionCreateDevice2(NULL, ...) is legal: create our own device. */
+static ID3D11Device *create_own_d3d11()
+{
+    ID3D11Device *dev = nullptr;
+    HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr,
+                                   D3D11_CREATE_DEVICE_BGRA_SUPPORT, nullptr, 0,
+                                   D3D11_SDK_VERSION, &dev, nullptr, nullptr);
+    if (FAILED(hr))
+        hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_WARP, nullptr,
+                               D3D11_CREATE_DEVICE_BGRA_SUPPORT, nullptr, 0,
+                               D3D11_SDK_VERSION, &dev, nullptr, nullptr);
+    LOG("create_own_d3d11 -> %08lx dev=%p", hr, dev);
+    return SUCCEEDED(hr) ? dev : nullptr;
+}
