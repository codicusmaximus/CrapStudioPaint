#!/usr/bin/env bash
# Launch Clip Studio Paint from the self-contained prefix. Works from any path
# (symlink it into ~/bin or point a .desktop file at it).
#
#   ./csp                 # start CSP (normal Xwayland/X11 window)
#   ./csp --gamescope     # start CSP inside a nested gamescope window
#   ./csp --studio        # start the CLIP STUDIO launcher instead of Paint
#   ./csp --wine winecfg  # run any Wine command in the prefix
#   ./csp --kill          # stop everything running in the prefix
set -euo pipefail
self="$(readlink -f "${BASH_SOURCE[0]}")"
source "$(dirname "$self")/env.sh"
source "$CSP_ROOT/scripts/relocate.sh"
relocate_prefix_user

# Chromium's sandbox doesn't work under Wine; without this, the WebView2
# panels (sign-in / start page) never get a renderer process.
export WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS="${WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS:-$CSP_WEBVIEW2_ARGS}"

# Tablet pressure/eraser fix for Wine's wintab under Xwayland (setup.sh tabletfix)
fix="$CSP_ROOT/lib/wintab-xi1-fix.so"
[[ -f "$fix" ]] && export LD_PRELOAD="$fix${LD_PRELOAD:+:$LD_PRELOAD}"

exe="$WINEPREFIX/$CSP_EXE_REL"
gamescope=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --gamescope) gamescope=1; shift;;
    --studio) exe="$WINEPREFIX/drive_c/Program Files/CELSYS/CLIP STUDIO 1.5/CLIP STUDIO/CLIPStudio.exe"; shift;;
    --wine) shift; exec "$WINE" "$@";;
    --kill) exec "$WINESERVER" -k;;
    -h|--help) sed -n '2,10p' "$self"; exit 0;;
    *) break;;
  esac
done

[[ -f "$exe" ]] || { echo "CSP is not installed in $WINEPREFIX — run ./setup.sh first" >&2; exit 1; }
cd "$(dirname "$exe")"

if (( gamescope )); then
  # Nested gamescope window; inside it a Wine virtual desktop of the same size
  # so CSP's dialogs and popups stay together. Writes the inner display info to
  # $XDG_RUNTIME_DIR/csp-gamescope.env so tools/gs-shot.sh can screenshot it.
  # Note: gamescope may not forward tablet pressure (see README).
  W="${GS_W:-1600}"; H="${GS_H:-900}"
  # A CSP session that is already running (e.g. an old gamescope window) would
  # swallow the new launch and the new window would close immediately.
  if pgrep -f 'csp-gamescope[.]env' >/dev/null || pgrep -f 'CLIP STUDIO 1[.]5' >/dev/null; then
    echo "Closing the already-running CSP session first..." >&2
    "$WINESERVER" -k 2>/dev/null || true
    pkill -f 'gamescope.*csp-gamescope[.]env' 2>/dev/null || true
    sleep 2
  fi
  info="${XDG_RUNTIME_DIR:-/tmp}/csp-gamescope.env"
  # On GNOME Wayland, gamescope's SDL window can fail to show up (no libdecor);
  # as an Xwayland window it reliably appears with normal decorations.
  export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-x11}"
  exec gamescope -W "$W" -H "$H" -w "$W" -h "$H" --backend sdl -- \
    bash -c 'printf "DISPLAY=%s\nGAMESCOPE_WAYLAND_DISPLAY=%s\nGS_SIZE=%s\n" "$DISPLAY" "$GAMESCOPE_WAYLAND_DISPLAY" "$1" > "$0"; shift 2; exec "$@"' \
    "$info" "${W}x${H}" _ "$WINE" explorer "/desktop=csp,${W}x${H}" "$exe" "$@"
fi
exec "$WINE" "$exe" "$@"
